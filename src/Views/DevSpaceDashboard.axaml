<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevBoard.ViewModels"
             xmlns:ds="using:DevBoard.DevSpaces"
             xmlns:v="using:DevBoard.Views"
             x:Class="DevBoard.Views.DevSpaceDashboard"
             x:DataType="vm:DevSpaceDashboard">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Spacing="12">
      <Border Padding="16" CornerRadius="6" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding WorkspaceName}"/>
            <TextBlock Opacity="0.7" Text="{Binding WorkspacePath}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{DynamicResource Text.DevSpaces.Branch}"/>
              <TextBlock Text="{Binding CurrentBranch}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{DynamicResource Text.DevSpaces.BaseBranch}"/>
              <TextBlock Text="{Binding BaseBranch}"/>
            </StackPanel>
            <TextBlock Text="{Binding AheadCount, StringFormat='↑ {0}'}"/>
            <TextBlock Text="{Binding BehindCount, StringFormat='↓ {0}'}"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{DynamicResource Text.DevSpaces.Changed}"/>
              <TextBlock Text="{Binding GitSummary.Total}"/>
            </StackPanel>
            <TextBlock Text="{Binding GitSummary.Added, StringFormat='+{0}'}"/>
            <TextBlock Text="{Binding GitSummary.Modified, StringFormat='~{0}'}"/>
            <TextBlock Text="{Binding GitSummary.Deleted, StringFormat='-{0}'}"/>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Center" Spacing="4">
            <Button Classes="flat" Content="{DynamicResource Text.DevSpaces.CopyPath}" Click="OnCopyPath"
                    ToolTip.Tip="{DynamicResource Text.DevSpaces.CopyPath}"/>
            <Button Classes="flat" Content="{DynamicResource Text.DevSpaces.OpenFolder}" Click="OnOpenFolder"
                    ToolTip.Tip="{DynamicResource Text.DevSpaces.OpenFolder}"/>
            <Button Classes="flat" Click="OnOpenFiles" ToolTip.Tip="{DynamicResource Text.DevSpaces.Files}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Width="13" Height="13" Data="{StaticResource Icons.Folder}"/>
                <TextBlock Text="{DynamicResource Text.DevSpaces.Files}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Primary dashboard: quick actions/health at left, repository stats/logs at right. -->
      <Grid ColumnDefinitions="430,*">
        <StackPanel Grid.Column="0" Margin="0,0,12,0" Spacing="12">
          <Border MinHeight="190" Padding="14" CornerRadius="6" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
            <StackPanel Spacing="10">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="{DynamicResource Text.DevSpaces.QuickStart}"/>
              <WrapPanel>
                <Button Margin="0,0,8,8" Tag="copilot" Click="OnStartAgent">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Image Width="16" Height="16" Source="/Resources/Images/ExternalToolIcons/githubcopilot.ico"/>
                    <TextBlock Text="Copilot" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Tag="codex" Click="OnStartAgent">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Image Width="16" Height="16" Source="/Resources/Images/ExternalToolIcons/codex.ico"/>
                    <TextBlock Text="Codex" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Tag="agy" Click="OnStartAgent">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Image Width="16" Height="16" Source="/Resources/Images/ExternalToolIcons/antigravity.ico"/>
                    <TextBlock Text="Antigravity" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Content="{DynamicResource Text.DevSpaces.NewTerminal}" Click="OnStartTerminal"/>
                <Button Margin="0,0,8,8" Content="{DynamicResource Text.DevSpaces.Files}" Click="OnOpenFiles"/>
              </WrapPanel>
              <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="ds:DevSpaceTerminalProfile">
                    <Button Margin="0,0,8,8" Content="{Binding DisplayName}" Click="OnStartProfile"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border MinHeight="190" Padding="14" CornerRadius="6" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
            <StackPanel Spacing="8">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="{DynamicResource Text.DevSpaces.WorkspaceHealth}"/>
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Copilot"/><TextBlock Grid.Column="1" Text="{Binding CopilotCapability}"/></Grid>
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Codex"/><TextBlock Grid.Column="1" Text="{Binding CodexCapability}"/></Grid>
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Antigravity"/><TextBlock Grid.Column="1" Text="{Binding AntigravityCapability}"/></Grid>
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="Roslyn" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding RoslynHealthStatusText}" ToolTip.Tip="{Binding RoslynFailureReason}"/>
                <Button Grid.Column="2" Classes="flat" IsVisible="{Binding CanInitializeRoslyn}" Content="{Binding RoslynActionText}" Click="OnInitializeRoslyn" ToolTip.Tip="{Binding RoslynFailureReason}"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="12">
          <!-- Repository statistics: existing Statistics VM + Chart control. -->
          <Border MinHeight="280" Padding="14" CornerRadius="6" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Text="Stats"/>
                <ListBox x:Name="StatisticsRangeSwitcher"
                         Grid.Column="1"
                         SelectedIndex="{Binding StatisticsRange, Mode=TwoWay}"
                         HorizontalAlignment="Right"
                         Background="Transparent"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource Brush.Border2}"
                         CornerRadius="12"
                         Padding="2,0">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Width" Value="76"/>
                      <Setter Property="Height" Value="26"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                      <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                      <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem Border.stats_range_bg">
                      <Setter Property="Height" Value="22"/>
                      <Setter Property="CornerRadius" Value="11"/>
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected Border.stats_range_bg">
                      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    </Style>
                    <Style Selector="TextBlock.stats_range_text">
                      <Setter Property="FontWeight" Value="SemiBold"/>
                      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
                      <Setter Property="HorizontalAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected TextBlock.stats_range_text">
                      <Setter Property="Foreground" Value="White"/>
                    </Style>
                  </ListBox.Styles>
                  <ListBoxItem>
                    <Border Classes="stats_range_bg">
                      <TextBlock Classes="stats_range_text" Text="Weekly"/>
                    </Border>
                  </ListBoxItem>
                  <ListBoxItem>
                    <Border Classes="stats_range_bg">
                      <TextBlock Classes="stats_range_text" Text="Monthly"/>
                    </Border>
                  </ListBoxItem>
                  <ListBoxItem>
                    <Border Classes="stats_range_bg">
                      <TextBlock Classes="stats_range_text" Text="Total"/>
                    </Border>
                  </ListBoxItem>
                </ListBox>
              </Grid>

              <Grid Grid.Row="1" Margin="0,10,0,0">
                <v:Chart Samples="{Binding RepositoryStatistics.Samples, Mode=OneWay}"
                         SampleBrush="{DynamicResource Brush.Accent}"
                         LabelFontFamily="{DynamicResource Fonts.Monospace}">
                  <v:Chart.DataTemplates>
                    <DataTemplate DataType="v:ChartToolTip">
                      <Border>
                        <StackPanel Orientation="Vertical">
                          <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="Bold"/>
                          <Grid Margin="0,8,0,0"
                                RowDefinitions="Auto,4,Auto" ColumnDefinitions="Auto,Auto"
                                IsVisible="{Binding HasUser, Mode=OneWay}">
                            <Ellipse Grid.Row="0" Grid.Column="0" Width="12" Height="12"
                                     Fill="{DynamicResource Brush.Accent}" Opacity="0.2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" Text="{Binding All, Mode=OneWay}"/>
                            <Ellipse Grid.Row="2" Grid.Column="0" Width="12" Height="12" Fill="{DynamicResource Brush.Accent}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="12,0,0,0" Text="{Binding User, Mode=OneWay}"/>
                          </Grid>
                          <StackPanel Margin="0,8,0,0" Orientation="Horizontal" IsVisible="{Binding !HasUser, Mode=OneWay}">
                            <Ellipse Width="12" Height="12" Fill="{DynamicResource Brush.Accent}"/>
                            <TextBlock Margin="12,0,0,0" Text="{Binding All, Mode=OneWay}"/>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </v:Chart.DataTemplates>
                </v:Chart>
                <v:LoadingIcon Width="40" Height="40"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding RepositoryStatistics.IsLoading}"/>
              </Grid>
            </Grid>
          </Border>

          <!-- Repository command logs: existing ViewLogs VM + log presenter. -->
          <Border MinHeight="330" Padding="14" CornerRadius="6" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="Logs"/>
              <Grid Grid.Row="1" Margin="0,10,0,0" ColumnDefinitions="240,4,*">
                <ListBox Grid.Column="0"
                         Padding="4"
                         Background="{DynamicResource Brush.Window}"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource Brush.Border2}"
                         ItemsSource="{Binding RepositoryLogs.Logs}"
                         SelectedItem="{Binding RepositoryLogs.SelectedLog, Mode=TwoWay}"
                         SelectionMode="Single"
                         Grid.IsSharedSizeScope="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Margin" Value="0"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Height" Value="28"/>
                      <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:CommandLog">
                      <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto" SharedSizeGroup="StartTimeColumn"/>
                          <ColumnDefinition Width="Auto" SharedSizeGroup="DurationColumn"/>
                        </Grid.ColumnDefinitions>
                        <v:LoadingIcon Grid.Column="0" Width="14" Height="14" Margin="4,0" IsVisible="{Binding !IsComplete}"/>
                        <TextBlock Grid.Column="1" Margin="4,0,0,0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Margin="4,0" Foreground="{DynamicResource Brush.FG2}" Text="{Binding StartTime, StringFormat=HH:mm:ss}"/>
                        <v:CommandLogTime Grid.Column="3" Margin="4,0" Foreground="{DynamicResource Brush.FG2}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Column="1"
                              MinWidth="1"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent"
                              BorderThickness="0"
                              Focusable="False"/>

                <Border Grid.Column="2"
                        BorderBrush="{DynamicResource Brush.Border2}"
                        BorderThickness="1"
                        Background="{DynamicResource Brush.Window}">
                  <v:CommandLogContentPresenter Log="{Binding RepositoryLogs.SelectedLog}"
                                                FontFamily="{DynamicResource Fonts.Monospace}"
                                                HorizontalScrollBarVisibility="Auto"
                                                VerticalScrollBarVisibility="Auto"/>
                </Border>
              </Grid>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Existing secondary cards stay available below the primary dashboard. -->
      <WrapPanel Orientation="Horizontal">
        <Border Width="430" MinHeight="190" Margin="0,0,12,12" Padding="14" CornerRadius="6" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="Active terminals"/>
              <Button Grid.Column="1" Classes="flat" Content="{DynamicResource Text.DevSpaces.CloseAll}" Click="OnCloseAll"
                      ToolTip.Tip="{DynamicResource Text.DevSpaces.CloseAll}"/>
            </Grid>
            <ItemsControl Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Sessions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DevSpaceDashboardSessionRow">
                  <Border Padding="8" Margin="0,0,0,4" CornerRadius="4" Background="{DynamicResource Brush.Window}" PointerPressed="OnSessionPressed">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                      <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center"
                                 FontFamily="Segoe UI Emoji" Text="{Binding Icon}" IsVisible="{Binding HasIcon}"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayTitle}"/>
                        <TextBlock FontSize="11" Opacity="0.65" Text="{Binding WorkingDirectory}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" Text="{Binding State}"/>
                      <Button Grid.Column="3" Classes="flat" Content="×" Click="OnCloseSession" PointerPressed="OnCloseSessionPointerPressed"
                              ToolTip.Tip="{DynamicResource Text.DevSpaces.CloseTerminal}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <Border Width="430" MinHeight="190" Margin="0,0,12,12" Padding="14" CornerRadius="6" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="{DynamicResource Text.DevSpaces.GitChanges}"/>
              <Button Grid.Column="1" Classes="flat" Content="{DynamicResource Text.DevSpaces.WorkingCopy}" Click="OnOpenWorkingCopy"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Text.DevSpaces.Changed}"/><TextBlock Grid.Column="1" Text="{Binding GitSummary.Total}"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Text.DevSpaces.Staged}"/><TextBlock Grid.Column="1" Text="{Binding GitSummary.Staged}"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Text.DevSpaces.Unstaged}"/><TextBlock Grid.Column="1" Text="{Binding GitSummary.Unstaged}"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Text.DevSpaces.Added}"/><TextBlock Grid.Column="1" Text="{Binding GitSummary.Added}"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Text.DevSpaces.Modified}"/><TextBlock Grid.Column="1" Text="{Binding GitSummary.Modified}"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Text.DevSpaces.Deleted}"/><TextBlock Grid.Column="1" Text="{Binding GitSummary.Deleted}"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Text.DevSpaces.Renamed}"/><TextBlock Grid.Column="1" Text="{Binding GitSummary.Renamed}"/></Grid>
          </StackPanel>
        </Border>

        <Border Width="430" MinHeight="190" Margin="0,0,12,12" Padding="14" CornerRadius="6" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
          <Grid RowDefinitions="Auto,*">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{DynamicResource Text.DevSpaces.RecentActivity}"/>
            <ItemsControl Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Activity}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DevSpaceActivityEntry">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,5">
                    <TextBlock Opacity="0.6" Text="{Binding At, StringFormat='{}{0:HH:mm}'}"/>
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Text}" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
