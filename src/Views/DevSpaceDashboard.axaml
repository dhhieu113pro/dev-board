<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SourceGit.ViewModels"
             x:Class="SourceGit.Views.DevSpaceDashboard"
             x:DataType="vm:DevSpaceDashboard">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Spacing="12">
      <Border Padding="16" CornerRadius="6" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding WorkspaceName}"/>
            <TextBlock Opacity="0.7" Text="{Binding WorkspacePath}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
            <TextBlock Text="{Binding CurrentBranch, StringFormat='Branch: {0}'}"/>
            <TextBlock Text="{Binding BaseBranch, StringFormat='Base: {0}'}"/>
            <TextBlock Text="{Binding AheadCount, StringFormat='↑ {0}'}"/>
            <TextBlock Text="{Binding BehindCount, StringFormat='↓ {0}'}"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
            <TextBlock Text="{Binding GitSummary.Total, StringFormat='Changed {0}'}"/>
            <TextBlock Text="{Binding GitSummary.Added, StringFormat='+{0}'}"/>
            <TextBlock Text="{Binding GitSummary.Modified, StringFormat='~{0}'}"/>
            <TextBlock Text="{Binding GitSummary.Deleted, StringFormat='-{0}'}"/>
            <TextBlock Text="{Binding GitSummary.Renamed, StringFormat='Renamed {0}'}"/>
          </StackPanel>
          <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Classes="flat" VerticalAlignment="Center" Click="OnOpenFiles">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Width="13" Height="13" Data="{StaticResource Icons.Folder}"/>
              <TextBlock Text="Files"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <WrapPanel Orientation="Horizontal">
        <Border Width="430" MinHeight="190" Margin="0,0,12,12" Padding="14" CornerRadius="6" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="Active Spaces"/>
              <Button Grid.Column="1" Classes="flat" Content="Close All" Click="OnCloseAll"/>
            </Grid>
            <ItemsControl Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Sessions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DevSpaceDashboardSessionRow">
                  <Border Padding="8" Margin="0,0,0,4" CornerRadius="4" Background="{DynamicResource Brush.Window}" PointerPressed="OnSessionPressed">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}"/>
                        <TextBlock FontSize="11" Opacity="0.65" Text="{Binding WorkingDirectory}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding State}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <Border Width="430" MinHeight="190" Margin="0,0,12,12" Padding="14" CornerRadius="6" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
          <StackPanel Spacing="10">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Quick Start"/>
            <WrapPanel>
              <Button Margin="0,0,8,8" Content="Copilot" Tag="copilot" Click="OnStartAgent"/>
              <Button Margin="0,0,8,8" Content="Codex" Tag="codex" Click="OnStartAgent"/>
              <Button Margin="0,0,8,8" Content="Antigravity" Tag="agy" Click="OnStartAgent"/>
              <Button Margin="0,0,8,8" Content="Terminal" Click="OnStartTerminal"/>
              <Button Margin="0,0,8,8" Content="Files" Click="OnOpenFiles"/>
            </WrapPanel>
            <TextBlock Opacity="0.65" Text="Roslyn diagnostics: unavailable until the Roslyn DevSpace integration is present." TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Width="430" MinHeight="190" Margin="0,0,12,12" Padding="14" CornerRadius="6" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
          <StackPanel Spacing="8">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Git Changes"/>
            <TextBlock Text="{Binding GitSummary.Total, StringFormat='Total changed files: {0}'}"/>
            <TextBlock Text="{Binding GitSummary.Staged, StringFormat='Staged: {0}'}"/>
            <TextBlock Text="{Binding GitSummary.Unstaged, StringFormat='Unstaged: {0}'}"/>
            <TextBlock Text="{Binding GitSummary.Added, StringFormat='Added: {0}'}"/>
            <TextBlock Text="{Binding GitSummary.Modified, StringFormat='Modified: {0}'}"/>
            <TextBlock Text="{Binding GitSummary.Deleted, StringFormat='Deleted: {0}'}"/>
            <TextBlock Text="{Binding GitSummary.Renamed, StringFormat='Renamed: {0}'}"/>
          </StackPanel>
        </Border>

        <Border Width="430" MinHeight="190" Margin="0,0,12,12" Padding="14" CornerRadius="6" Background="{DynamicResource Brush.Contents}" BorderBrush="{DynamicResource Brush.Border2}" BorderThickness="1">
          <Grid RowDefinitions="Auto,*">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Recent Activity"/>
            <ItemsControl Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Activity}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DevSpaceActivityEntry">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,5">
                    <TextBlock Opacity="0.6" Text="{Binding At, StringFormat='{}{0:HH:mm}'}"/>
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Text}" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
