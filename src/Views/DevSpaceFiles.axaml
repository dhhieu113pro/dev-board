<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevBoard.ViewModels"
             xmlns:v="using:DevBoard.Views"
             x:Class="DevBoard.Views.DevSpaceFiles"
             x:DataType="vm:DevSpaceFiles">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light"><Color x:Key="Color.DevSpaceFile.RootFolder">#FF2878D4</Color><Color x:Key="Color.DevSpaceFile.Folder">#FFC18B00</Color><Color x:Key="Color.DevSpaceFile.Web">#FF1473E6</Color><Color x:Key="Color.DevSpaceFile.Green">#FF16833B</Color><Color x:Key="Color.DevSpaceFile.Purple">#FF7B3FB3</Color><Color x:Key="Color.DevSpaceFile.Blue">#FF1668C7</Color><Color x:Key="Color.DevSpaceFile.Orange">#FFA85A00</Color><Color x:Key="Color.DevSpaceFile.Neutral">#FF626262</Color></ResourceDictionary>
        <ResourceDictionary x:Key="Dark"><Color x:Key="Color.DevSpaceFile.RootFolder">#FF63A8F5</Color><Color x:Key="Color.DevSpaceFile.Folder">#FFF0C04C</Color><Color x:Key="Color.DevSpaceFile.Web">#FF69B1FF</Color><Color x:Key="Color.DevSpaceFile.Green">#FF67C879</Color><Color x:Key="Color.DevSpaceFile.Purple">#FFC58AF0</Color><Color x:Key="Color.DevSpaceFile.Blue">#FF73B7FF</Color><Color x:Key="Color.DevSpaceFile.Orange">#FFFFB35A</Color><Color x:Key="Color.DevSpaceFile.Neutral">#FFB7B7B7</Color></ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="Brush.DevSpaceFile.RootFolder" Color="{DynamicResource Color.DevSpaceFile.RootFolder}"/><SolidColorBrush x:Key="Brush.DevSpaceFile.Folder" Color="{DynamicResource Color.DevSpaceFile.Folder}"/><SolidColorBrush x:Key="Brush.DevSpaceFile.Web" Color="{DynamicResource Color.DevSpaceFile.Web}"/><SolidColorBrush x:Key="Brush.DevSpaceFile.Green" Color="{DynamicResource Color.DevSpaceFile.Green}"/><SolidColorBrush x:Key="Brush.DevSpaceFile.Purple" Color="{DynamicResource Color.DevSpaceFile.Purple}"/><SolidColorBrush x:Key="Brush.DevSpaceFile.Blue" Color="{DynamicResource Color.DevSpaceFile.Blue}"/><SolidColorBrush x:Key="Brush.DevSpaceFile.Orange" Color="{DynamicResource Color.DevSpaceFile.Orange}"/><SolidColorBrush x:Key="Brush.DevSpaceFile.Neutral" Color="{DynamicResource Color.DevSpaceFile.Neutral}"/>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid ColumnDefinitions="300,1,*">
    <Grid Grid.Column="0" RowDefinitions="38,*">
      <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border2}"><Grid ColumnDefinitions="*,32" Margin="6,4"><TextBox Grid.Column="0" Height="28" Watermark="Search files..." Text="{Binding Filter, Mode=TwoWay}"/><Button Grid.Column="1" Classes="icon_button" Width="28" Height="28" Margin="4,0,0,0" Click="OnRefresh" ToolTip.Tip="Refresh files"><TextBlock Text="↻" FontSize="16"/></Button></Grid></Border>
      <ListBox Grid.Row="1" Margin="2" ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" DoubleTapped="OnTreeDoubleTapped">
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:DevSpaceFileNode"><Grid Height="28" Margin="{Binding Indent}" ColumnDefinitions="20,22,*,24"><Button Grid.Column="0" Classes="icon_button" Width="20" Height="24" Padding="0" Background="Transparent" BorderThickness="0" IsVisible="{Binding IsDirectory}" Click="OnTreeArrowClick" DoubleTapped="OnTreeArrowDoubleTapped" ToolTip.Tip="Expand/collapse folder"><TextBlock Text="{Binding ExpansionGlyph}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Button><Grid Grid.Column="1" Width="20" Height="20" IsHitTestVisible="False"><Path Width="15" Height="15" Data="{StaticResource Icons.Folder}" Fill="{DynamicResource Brush.DevSpaceFile.Folder}" IsVisible="{Binding IsFolderIcon}"/><Path Width="15" Height="15" Data="{StaticResource Icons.Folder}" Fill="{DynamicResource Brush.DevSpaceFile.RootFolder}" IsVisible="{Binding IsRootFolderIcon}"/><TextBlock Text="◎" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.DevSpaceFile.Web}" IsVisible="{Binding IsWebRootIcon}"/><TextBlock Text="{}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.DevSpaceFile.Green}" IsVisible="{Binding IsJsonIcon}"/><TextBlock Text="C#" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.DevSpaceFile.Green}" IsVisible="{Binding IsCSharpIcon}"/><TextBlock Text="C#" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.DevSpaceFile.Purple}" IsVisible="{Binding IsCSharpProjectIcon}"/><TextBlock Text="S" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.DevSpaceFile.Purple}" IsVisible="{Binding IsSolutionIcon}"/><TextBlock Text="⚙" FontSize="13" Foreground="{DynamicResource Brush.DevSpaceFile.Neutral}" IsVisible="{Binding IsConfigIcon}"/><TextBlock Text="&lt;&gt;" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.DevSpaceFile.Orange}" IsVisible="{Binding IsXmlIcon}"/><TextBlock Text="M" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.DevSpaceFile.Blue}" IsVisible="{Binding IsMarkdownIcon}"/><TextBlock Text="▣" FontSize="13" Foreground="{DynamicResource Brush.DevSpaceFile.Purple}" IsVisible="{Binding IsImageIcon}"/><TextBlock Text="JS" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.DevSpaceFile.Orange}" IsVisible="{Binding IsJavaScriptIcon}"/><TextBlock Text="TS" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Brush.DevSpaceFile.Blue}" IsVisible="{Binding IsTypeScriptIcon}"/><TextBlock Text="#" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.DevSpaceFile.Blue}" IsVisible="{Binding IsCssIcon}"/><Path Width="12" Height="12" Data="{StaticResource Icons.File.Empty}" Fill="{DynamicResource Brush.DevSpaceFile.Neutral}" IsVisible="{Binding IsGenericFileIcon}"/></Grid><TextBlock Grid.Column="2" Margin="4,0" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RelativePath}"/><TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding StatusText}"/></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <Border Grid.Column="1" Background="{DynamicResource Brush.Border2}"/>
    <Grid Grid.Column="2">
      <ItemsControl ItemsSource="{Binding FolderChildren}" Margin="16"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="120" ItemHeight="100"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DevSpaceFileNode"><Button Width="112" Height="92" Margin="4" Padding="8" Background="Transparent" DoubleTapped="OnFolderChildDoubleTapped" ToolTip.Tip="{Binding RelativePath}"><StackPanel HorizontalAlignment="Center" Spacing="6"><Grid Width="42" Height="42"><Path Width="36" Height="36" Data="{StaticResource Icons.Folder}" Fill="{DynamicResource Brush.DevSpaceFile.Folder}" IsVisible="{Binding IsDirectory}"/><TextBlock Text="{}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.DevSpaceFile.Green}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsJsonIcon}"/><TextBlock Text="C#" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.DevSpaceFile.Green}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsCSharpIcon}"/><Path Width="30" Height="30" Data="{StaticResource Icons.File.Empty}" Fill="{DynamicResource Brush.DevSpaceFile.Neutral}" IsVisible="{Binding IsGenericFileIcon}"/></Grid><TextBlock Width="96" Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}" Text="Select a file or folder"/>
      <ContentControl Content="{Binding DetailContext}"><ContentControl.DataTemplates><DataTemplate DataType="vm:DiffContext"><v:DiffView/></DataTemplate><DataTemplate DataType="vm:DevSpaceWorkspaceFile"><Grid RowDefinitions="30,*"><Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border2}"><Grid ColumnDefinitions="*,Auto"><TextBlock Grid.Column="0" Margin="8,0" VerticalAlignment="Center" Text="{Binding Path}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Message}"/></Grid></Border><TextBox Grid.Row="1" Padding="8" BorderThickness="0" AcceptsReturn="True" AcceptsTab="True" IsReadOnly="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource Fonts.Monospace}" Text="{Binding Content}"/></Grid></DataTemplate></ContentControl.DataTemplates></ContentControl>
    </Grid>
  </Grid>
</UserControl>
