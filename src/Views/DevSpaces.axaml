<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevBoard.ViewModels"
             xmlns:v="using:DevBoard.Views"
             x:Class="DevBoard.Views.DevSpaces"
             x:DataType="vm:DevSpaces">
  <Grid RowDefinitions="Auto,*">
    <!-- Dev Dashboard owns only its Dashboard tab. Other tools use repository-level navigation. -->
    <Border Grid.Row="0"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.ToolBar}"
            IsVisible="{Binding IsDashboardActive}">
      <StackPanel Orientation="Horizontal">
        <Border Height="32"
                Margin="2,2,0,2"
                Padding="10,0"
                CornerRadius="4"
                Background="{DynamicResource Brush.Contents}"
                PointerPressed="OnDashboardTabPressed">
          <TextBlock VerticalAlignment="Center" Text="{DynamicResource Text.DevSpaces.Dashboard}"/>
        </Border>
      </StackPanel>
    </Border>

    <!-- Terminal-specific controls stay with the terminal page without becoming Dev Dashboard tabs. -->
    <Border Grid.Row="0"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.ToolBar}"
            IsVisible="{Binding IsTerminalsActive}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Sessions}" IsVisible="{Binding IsTerminalsActive}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DevSpaceTerminal">
                <Border Height="32"
                        Margin="2,2,0,2"
                        Padding="8,0,2,0"
                        CornerRadius="4"
                        Background="{DynamicResource Brush.Contents}"
                        PointerPressed="OnTerminalTabPressed">
                  <Grid ColumnDefinitions="Auto,Auto,Auto">
                    <Image Width="16" Height="16"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Source="{Binding AgentIcon}"
                           IsVisible="{Binding HasAgentIcon}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Title}"/>
                    <Button Grid.Column="2"
                            Classes="icon_button"
                            Width="24" Height="24"
                            Margin="4,0,0,0"
                            Click="OnCloseTerminal"
                            ToolTip.Tip="{DynamicResource Text.DevSpaces.CloseTerminal}">
                      <Path Width="10" Height="10" Data="{StaticResource Icons.Clear}"/>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <ComboBox Grid.Column="1"
                  Width="92" Height="28"
                  Margin="8,4,0,4"
                  SelectedIndex="{Binding LayoutIndex, Mode=TwoWay}">
          <ComboBoxItem Content="{DynamicResource Text.DevSpaces.Layout.Auto}"/>
          <ComboBoxItem Content="{DynamicResource Text.DevSpaces.Layout.Tab}"/>
          <ComboBoxItem Content="{DynamicResource Text.DevSpaces.Layout.1x2}"/>
          <ComboBoxItem Content="{DynamicResource Text.DevSpaces.Layout.2x2}"/>
          <ComboBoxItem Content="{DynamicResource Text.DevSpaces.Layout.3x3}"/>
        </ComboBox>

        <Button Grid.Column="2"
                Classes="icon_button"
                Width="30" Height="30"
                Margin="4,3,6,3"
                Click="OnCreateTerminal"
                ToolTip.Tip="{DynamicResource Text.DevSpaces.NewTerminal}">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Plus}"/>
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <v:DevSpaceDashboard x:Name="DashboardView" DataContext="{Binding Dashboard}"/>
      <v:DevSpaceFiles x:Name="FilesView" DataContext="{Binding Files}"/>
      <v:DevSpaceAIRouter x:Name="AIRouterView" IsVisible="False"/>
      <v:DevSpaceRoslynAnalytics IsVisible="{Binding IsRoslynActive}"/>
      <Grid x:Name="TerminalGrid" Margin="2"/>
      <Border x:Name="AgentHost" Margin="2" IsVisible="False"/>
    </Grid>
  </Grid>
</UserControl>
