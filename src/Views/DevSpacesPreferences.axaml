<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevBoard.ViewModels"
             xmlns:m="using:DevBoard.Models"
             xmlns:mcp="using:DevBoard.Mcp"
             x:Class="DevBoard.Views.DevSpacesPreferences"
             x:DataType="vm:Preferences">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <Grid Margin="16" RowDefinitions="36,36,36,12,36,36,16,Auto" ColumnDefinitions="Auto,*">
      <CheckBox Grid.Row="0" Grid.Column="1"
                VerticalAlignment="Center"
                Content="{DynamicResource Text.DevSpaces.Enable}"
                IsChecked="{Binding EnableDevSpaces, Mode=TwoWay}"
                Checked="OnEnableChanged"
                Unchecked="OnEnableChanged"/>

      <TextBlock Grid.Row="1" Grid.Column="0"
                 Margin="0,0,16,0"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Text="{DynamicResource Text.DevSpaces.DefaultCommand}"/>
      <TextBox Grid.Row="1" Grid.Column="1"
               Height="28"
               VerticalContentAlignment="Center"
               Text="{Binding DevSpacesDefaultCommand, Mode=TwoWay}"/>

      <TextBlock Grid.Row="2" Grid.Column="0"
                 Margin="0,0,16,0"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Text="{DynamicResource Text.DevSpaces.DefaultLayout}"/>
      <ComboBox Grid.Row="2" Grid.Column="1"
                Height="28"
                SelectedIndex="{Binding DevSpacesDefaultLayoutIndex, Mode=TwoWay}">
        <ComboBoxItem Content="{DynamicResource Text.DevSpaces.Layout.Auto}"/>
        <ComboBoxItem Content="{DynamicResource Text.DevSpaces.Layout.1x2}"/>
        <ComboBoxItem Content="{DynamicResource Text.DevSpaces.Layout.2x2}"/>
        <ComboBoxItem Content="{DynamicResource Text.DevSpaces.Layout.3x3}"/>
      </ComboBox>

      <Rectangle Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                 Height="1" Margin="0,5"
                 Fill="{DynamicResource Brush.Border2}"/>

      <TextBlock Grid.Row="4" Grid.Column="0"
                 Margin="0,0,16,0"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Text="{DynamicResource Text.DevSpaces.TabLayout}"/>
      <ComboBox Grid.Row="4" Grid.Column="1"
                Height="28"
                SelectedIndex="{Binding Source={x:Static m:LauncherTabSettings.Instance}, Path=LayoutIndex, Mode=TwoWay}">
        <ComboBoxItem Content="{DynamicResource Text.DevSpaces.TabLayout.Horizontal}"/>
        <ComboBoxItem Content="{DynamicResource Text.DevSpaces.TabLayout.Vertical}"/>
      </ComboBox>

      <TextBlock Grid.Row="5" Grid.Column="0"
                 Margin="0,0,16,0"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Text="{DynamicResource Text.DevSpaces.TabLayout.VerticalWidth}"
                 IsVisible="{Binding Source={x:Static m:LauncherTabSettings.Instance}, Path=IsVertical}"/>
      <NumericUpDown Grid.Row="5" Grid.Column="1"
                     Minimum="160" Maximum="420" Increment="10"
                     Height="28"
                     Padding="4"
                     BorderThickness="1" BorderBrush="{DynamicResource Brush.Border1}"
                     CornerRadius="3"
                     Value="{Binding Source={x:Static m:LauncherTabSettings.Instance}, Path=VerticalWidth, Mode=TwoWay}"
                     IsVisible="{Binding Source={x:Static m:LauncherTabSettings.Instance}, Path=IsVertical}"/>

      <Separator Grid.Row="6" Grid.ColumnSpan="2"
                 Margin="0,7"/>

      <Grid x:Name="McpSettingsPanel"
            Grid.Row="7"
            Grid.ColumnSpan="2"
            x:DataType="mcp:DevBoardMcpSettings"
            RowDefinitions="32,36,36,36,36,32,36,Auto,Auto,Auto,Auto,Auto,Auto"
            ColumnDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="MCP"/>

        <CheckBox Grid.Row="1" Grid.Column="1"
                  VerticalAlignment="Center"
                  Content="Enable MCP server"
                  IsChecked="{Binding Enabled, Mode=TwoWay}"/>

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Margin="0,0,16,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Text="Port"/>
        <TextBox Grid.Row="2" Grid.Column="1"
                 Height="28"
                 VerticalContentAlignment="Center"
                 Text="{Binding Port, Mode=TwoWay}"/>

        <TextBlock Grid.Row="3" Grid.Column="0"
                   Margin="0,0,16,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Text="SSE endpoint"/>
        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto">
          <TextBox x:Name="McpEndpointTextBox"
                   Grid.Column="0"
                   Height="28"
                   IsReadOnly="True"
                   VerticalContentAlignment="Center"
                   Text="{Binding DisplayEndpoint}"/>
          <Button Grid.Column="1"
                  Margin="8,0,0,0"
                  Padding="12,0"
                  Content="Copy"
                  Click="OnCopyMcpEndpoint"/>
        </Grid>

        <TextBlock Grid.Row="4" Grid.Column="0"
                   Margin="0,0,16,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="Token"/>
        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto,Auto">
          <Grid Grid.Column="0">
            <TextBox x:Name="MaskedMcpTokenTextBox"
                     Height="28"
                     IsReadOnly="True"
                     PasswordChar="●"
                     VerticalContentAlignment="Center"
                     Text="{Binding AuthToken}"/>
            <TextBox x:Name="VisibleMcpTokenTextBox"
                     Height="28"
                     IsReadOnly="True"
                     IsVisible="False"
                     VerticalContentAlignment="Center"
                     Text="{Binding AuthToken}"/>
          </Grid>
          <Button x:Name="ToggleMcpTokenButton"
                  Grid.Column="1"
                  Margin="8,0,0,0"
                  MinWidth="44"
                  Padding="10,0"
                  Content="Show"
                  Click="OnToggleMcpToken"/>
          <Button Grid.Column="2"
                  Margin="8,0,0,0"
                  Padding="12,0"
                  Content="Copy"
                  Click="OnCopyMcpToken"/>
        </Grid>

        <Button Grid.Row="5" Grid.Column="1"
                HorizontalAlignment="Right"
                Padding="8,0"
                Content="Regenerate token"
                Click="OnRegenerateMcpToken"/>

        <TextBlock Grid.Row="6" Grid.Column="0"
                   Margin="0,0,16,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Text="Status"/>
        <Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding RuntimeStatus}"/>
            <TextBlock x:Name="McpConnectionTestResult"
                       VerticalAlignment="Center"
                       Opacity="0.7"/>
          </StackPanel>
          <Button x:Name="TestMcpConnectionButton"
                  Grid.Column="1"
                  Padding="12,0"
                  Content="Test connection"
                  Click="OnTestMcpConnection"/>
        </Grid>

        <TextBlock Grid.Row="7" Grid.Column="1"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding RuntimeError}"/>

        <TextBlock Grid.Row="8" Grid.ColumnSpan="2"
                   Margin="0,16,0,4"
                   FontWeight="SemiBold"
                   Text="Connect your MCP client"/>

        <TextBlock Grid.Row="9" Grid.Column="1"
                   Margin="0,4,0,8"
                   TextWrapping="Wrap"
                   Text="Enable the MCP server, copy the configuration below into your MCP client, then reconnect the client."/>

        <Grid Grid.Row="10" Grid.Column="1" RowDefinitions="Auto,Auto">
          <Button Grid.Row="0"
                  HorizontalAlignment="Right"
                  Margin="0,0,0,6"
                  Padding="12,4"
                  Content="Copy MCP configuration"
                  Click="OnCopyMcpConfiguration"/>
          <TextBox x:Name="McpConfigurationTextBox"
                   Grid.Row="1"
                   MinHeight="150"
                   AcceptsReturn="True"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   IsReadOnly="True"
                   Text="{Binding McpClientConfiguration}"
                   TextWrapping="NoWrap"/>
        </Grid>

        <CheckBox Grid.Row="11" Grid.Column="1"
                  Margin="0,12,0,0"
                  VerticalAlignment="Center"
                  Content="Share DevSpace terminal output"
                  IsChecked="{Binding ShareDevSpaceTerminalOutput, Mode=TwoWay}"/>

        <TextBlock Grid.Row="12" Grid.Column="1"
                   Margin="0,8,0,0"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Text="Keep the authentication token secret. The generated configuration contains it. Terminal output can also contain secrets. MCP is localhost-only and read-only."/>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
