<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevBoard.ViewModels"
             xmlns:m="using:DevBoard.Models"
             xmlns:v="using:DevBoard.Views"
             xmlns:c="using:DevBoard.Converters"
             x:Class="DevBoard.Views.PullRequestCherryPickPage"
             x:DataType="vm:PullRequestCherryPickPage">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,180,Auto,120,Auto,*" ColumnSpacing="8">
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Remote"/>
      <ComboBox Grid.Column="1"
                Height="28"
                ItemsSource="{Binding SupportedRemotes}"
                SelectedItem="{Binding SelectedRemote, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="m:Remote">
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Pull Request #"/>
      <TextBox Grid.Column="3"
               Height="28"
               Watermark="42"
               Text="{Binding PullRequestNumber, Mode=TwoWay}"
               VerticalContentAlignment="Center"/>

      <Button Grid.Column="4"
              Height="28"
              Padding="12,0"
              Content="Load"
              Click="OnLoadPullRequest"
              IsEnabled="{Binding !IsLoading}"/>

      <TextBlock Grid.Column="5"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.FG2}"
                 Text="GitHub and Azure DevOps"/>
    </Grid>

    <Grid Grid.Row="1" Margin="0,10,0,8" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.FG2}"
                 Text="{Binding StatusMessage}"
                 TextWrapping="Wrap"/>
      <Button Grid.Column="1"
              Height="28"
              Padding="12,0"
              Content="🍒 Cherry-pick all"
              Click="OnCherryPickAll"
              IsVisible="{Binding HasCommits}"
              IsEnabled="{Binding !IsLoading}"/>
    </Grid>

    <Grid Grid.Row="2">
      <ListBox ItemsSource="{Binding Commits}"
               BorderThickness="1"
               BorderBrush="{DynamicResource Brush.Border2}"
               Background="{DynamicResource Brush.Contents}"
               CornerRadius="4"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="m:Commit">
            <Grid MinHeight="42" Margin="8,4" ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         FontFamily="{DynamicResource Fonts.Monospace}"
                         Foreground="{DynamicResource Brush.FG2}"
                         Text="{Binding SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"/>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Margin="0,2,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.FG2}"
                           Text="{Binding Author.Name}"/>
              </StackPanel>

              <Button Grid.Column="2"
                      Margin="10,0,0,0"
                      Padding="10,2"
                      Tag="{Binding}"
                      Content="🍒 Cherry-pick"
                      Click="OnCherryPickCommit"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.FG2}"
                 Text="Enter a pull request number to load its commits."
                 IsVisible="{Binding !HasCommits}"/>

      <v:LoadingIcon Width="42" Height="42"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsVisible="{Binding IsLoading}"/>
    </Grid>
  </Grid>
</UserControl>
